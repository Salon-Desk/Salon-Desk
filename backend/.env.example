ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salondesk
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=https?://(.*\.)?huludelala\.com

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# LLM — pick one: groq | ollama | openai
LLM_PROVIDER=groq

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (when LLM_PROVIDER=ollama) — local; API key usually unused
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

LLM_TIMEOUT_SECONDS=60

# Embeddings / RAG
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=all-minilm
RAG_CHUNK_LIMIT=6
VOICE_RAG_TIMEOUT_S=4.5
VOICE_RAG_CHUNK_LIMIT=6

# LiveKit voice agent
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=salondesk-voice
DEEPGRAM_API_KEY=
VOICE_STT_PROVIDER=deepgram
VOICE_TTS_PROVIDER=deepgram

ED25519_PRIVATE_KEY=
