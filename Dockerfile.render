# Render production image: FastAPI + Next.js + nginx + voice worker
# Uses Render managed Postgres (pgvector). Does NOT embed PostgreSQL.
#
# Render Dashboard → Web Service → Docker:
#   Dockerfile Path: Dockerfile.render
#   Docker Context:  .
#
# Required env: DATABASE_URL (Render Postgres Internal URL; use postgresql+asyncpg://)
# Listens on $PORT (Render injects this; default 10000).
#
# VPS / all-in-one image remains: Dockerfile (unchanged).

FROM python:3.11-slim-bookworm AS api-builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM node:22-bookworm-slim AS node-runtime

FROM node:22-alpine AS web-builder
WORKDIR /build
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/.npmrc ./
RUN pnpm install --frozen-lockfile --config.dangerously-allow-all-builds=true
COPY frontend/ .
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_SITE_URL=
ARG NEXT_PUBLIC_LIVEKIT_URL=
ARG NEXT_PUBLIC_ENABLE_AGENT_CHAT=true
ARG NEXT_PUBLIC_ENABLE_VOICE_AGENT=true
ARG NEXT_PUBLIC_ENABLE_SIMULATION=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_LIVEKIT_URL=$NEXT_PUBLIC_LIVEKIT_URL \
    NEXT_PUBLIC_ENABLE_AGENT_CHAT=$NEXT_PUBLIC_ENABLE_AGENT_CHAT \
    NEXT_PUBLIC_ENABLE_VOICE_AGENT=$NEXT_PUBLIC_ENABLE_VOICE_AGENT \
    NEXT_PUBLIC_ENABLE_SIMULATION=$NEXT_PUBLIC_ENABLE_SIMULATION \
    NEXT_TELEMETRY_DISABLED=1
RUN pnpm run build

FROM debian:bookworm-slim AS runner
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl nginx supervisor postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log/supervisor /run/nginx \
    && rm -f /etc/nginx/sites-enabled/default

ENV PYTHONUNBUFFERED=1
ENV PATH=/usr/local/bin:$PATH
ENV PYTHONPATH=/app/backend
ENV PORT=10000
ENV STORAGE_BACKEND=local
ENV STORAGE_LOCAL_DIR=/var/lib/salondesk/storage

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=api-builder /usr/local /usr/local
COPY backend/ /app/backend/
WORKDIR /app/backend

COPY --from=web-builder /build/public /app/frontend/public
COPY --from=web-builder /build/.next/standalone /app/frontend
COPY --from=web-builder /build/.next/static /app/frontend/.next/static

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs nextjs \
    && chown -R nextjs:nodejs /app/frontend

COPY deploy/render/nginx.conf.template /app/deploy/render/nginx.conf.template
COPY deploy/render/supervisord.conf /etc/supervisor/conf.d/salondesk.conf
COPY deploy/render/entrypoint.sh deploy/render/api-start.sh deploy/render/voice-start.sh /app/deploy/render/
RUN chmod +x /app/deploy/render/entrypoint.sh /app/deploy/render/api-start.sh /app/deploy/render/voice-start.sh \
    && mkdir -p /var/lib/salondesk/storage

VOLUME ["/var/lib/salondesk/storage"]

EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
    CMD curl -f "http://127.0.0.1:${PORT:-10000}/health" || exit 1

ENTRYPOINT ["/app/deploy/render/entrypoint.sh"]
