# Copy to .env at repo root: cp .env.example .env
# VPS (single container): copy the same file to /opt/salondesk/.env on the server.

# Postgres (db service / embedded DB in single-container image)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salondesk
# Host port for Compose `db` (change if local Postgres already uses 5432)
POSTGRES_PORT=5432

# API (async SQLAlchemy URL — host must be `db` inside Compose).
# On the host, FastAPI rewrites `@db` → `localhost:${POSTGRES_PORT}` automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/salondesk
ENVIRONMENT=development
DEBUG=true
# Set to false in production to hide demo simulation buttons in the UI
NEXT_PUBLIC_ENABLE_SIMULATION=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Browser origins allowed by the API (credentials enabled).
# Comma-separated OR JSON array both work (NoDecode + parser).
# Production example:
# CORS_ORIGINS=["https://paypalai.hackathon.huludelala.com","http://paypalai.hackathon.huludelala.com","http://localhost:3000"]
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000
# Optional regex (disable with CORS_ORIGIN_REGEX=none)
CORS_ORIGIN_REGEX=https?://(.*\.)?huludelala\.com

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# LLM — pick one: groq | ollama | openai | deepseek
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
LLM_TIMEOUT_SECONDS=60

# Embeddings / RAG (Ollama all-minilm → 384-d)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=all-minilm
RAG_CHUNK_LIMIT=6
VOICE_RAG_TIMEOUT_S=4.5
VOICE_RAG_CHUNK_LIMIT=6

# LiveKit voice agent (separate worker: python agent.py start)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the worker name. Leave unset to use salondesk-voice; do not set empty.
LIVEKIT_AGENT_NAME=salondesk-voice
DEEPGRAM_API_KEY=
VOICE_STT_PROVIDER=deepgram
VOICE_TTS_PROVIDER=deepgram
# Optional override; defaults to LLM_PROVIDER
# VOICE_LLM_PROVIDER=groq

ED25519_PRIVATE_KEY=

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Object storage
# Compose (multi-service): s3 + the rustfs service. All-in-one VPS image defaults to local disk.
# STORAGE_BACKEND=s3
# STORAGE_LOCAL_DIR=/var/lib/salondesk/storage
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_ENDPOINT_URL=http://localhost:9000
RUSTFS_BUCKET=salondesk-assets
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/api/v1/storage

# Frontend (copy to frontend/.env — demo reset/concierge may use Next route handlers)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# LiveKit Cloud URL (browser joins this; JWT from POST /api/v1/livekit/token)
NEXT_PUBLIC_LIVEKIT_URL=
# Chat / voice agent UI flags (rebuild Next after changing)
NEXT_PUBLIC_ENABLE_AGENT_CHAT=true
NEXT_PUBLIC_ENABLE_VOICE_AGENT=true
