# Copy to .env at repo root: cp .env.example .env
# VPS (single container): copy the same file to /opt/salondesk/.env on the server.

# Postgres (db service / embedded DB in single-container image)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salondesk

# API (async SQLAlchemy URL — host must be `db` inside Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/salondesk
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Local dev (compose multi-service): http://localhost:3000
# Single-container / VPS behind nginx on port 80: include your public origin
CORS_ORIGINS=["http://localhost:3000","http://localhost"]

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

ED25519_PRIVATE_KEY=

# Frontend (optional — demo reset/concierge use Next.js route handlers in-container)
NEXT_PUBLIC_API_URL=http://localhost:8000
